<h1>Bugs</h1>
<table class="table table-hover">
  <thead>
    <tr>
      <th scope="col">#</th>
      <th scope="col">Project name</th>
      <th scope="col">Title</th>
      <th scope="col">Type</th>
      <th scope="col">Status</th>
      <th scope="col">Deadline</th>
      <%if(current_user.user_type!="Manager")%>
          <th scope="col">Actions</th>
      <%end%>
       <th colspan="3"></th>
    </tr>
  </thead>
  <tbody>
    <tr>
     <%count=0%>
     <% @bugs.each do |i| %>
      <tr>
        <th scope="row"><%= count+=1%></th>
        <td><%= i.project.name %></td>
        <td><%= i.title %></td>
        <td><%= i.bug_type %></td>
        <td><%= i.status %></td>
        <td><%=i.deadline %></td>
        <%if(current_user.user_type=="Qa")%> 
           <td><%= link_to 'Edit Bug', edit_project_bug_path(@project, i),class:'btn btn-outline-secondary'%></td>
           <td><%= button_to "Delete Bug",[@project,i], method: :delete, data: {confirm: "Are you sure?"},class:'btn btn-outline-secondary'%></td>
        <%elsif(current_user.user_type=="Developer")%>
          <td><%= link_to 'Update status', edit_project_bug_path(@project, i),class:'btn btn-outline-secondary'%></td>
          <% if (i.status!="resolved")%>
              <td><%= link_to 'Pick Bug', assign_bug_project_bug_path(@project,i),class:'btn btn-outline-secondary',style:'margin-left: -42%;' %></td>
          <%end%>
        <%else%>
        <%end%>
      </tr>
     <% end %>
    </tr>
  </tbody>
</table>
<div class="container">
    <%= link_to 'Back', project_details_project_path(@project), class:'btn btn-outline-secondary'%>
</div>

