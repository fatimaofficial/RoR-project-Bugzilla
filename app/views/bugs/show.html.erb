<h1>Updated Bug</h1>
<table class="table table-hover">
  <thead>
    <tr>
      <th scope="col">#</th>
      <th scope="col">Project name</th>
      <th scope="col">Bug Title</th>
      <th scope="col">Type</th>
      <th scope="col">Status</th>
      <th scope="col">Deadline</th>  
    </tr>
  </thead>
  <tbody>
    <tr>
      <tr>
        <th scope="row"><%= @bug.id%></th>
        <td><%= @project.name %></td>
        <td><%= @bug.title %></td>
        <td><%= @bug.bug_type %></td>
        <td><%= @bug.status %></td>
        <td><%=@bug.deadline %></td>
      </tr>
    </tr>
    
  </tbody>
</table><br>
 <div class="container">
     <td><%= link_to 'Back', project_bugs_path(@project) ,class:'btn btn-outline-secondary'%></td>
 </div>