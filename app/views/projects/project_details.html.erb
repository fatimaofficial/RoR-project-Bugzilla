<h1>Project Details</h1>
<%if(current_user.type=="Manager")%> 
   <div class="row">
      <div class="col-6">
      </div>
      <div class="col-6">
         <%= link_to "Edit Project", edit_project_path(@project),class:'btn btn-outline-secondary',style:"margin-left:52%" %>
         <%= button_to "Delete Project",[@project], method: :delete, data: {confirm: "Are you sure?"},class:'btn btn-outline-secondary',style:"margin-left: 75%;margin-top: -12%;"%>
      </div>
      <br><br>
   </div>
   <h4>Name:</h4>
   <p><%= @project.name%></p>
   <h4>Description: </h4><p><%= @project.description%></p><br>
   <p><%= link_to 'Show Bugs', project_bugs_path(@project),class:'btn btn-outline-secondary' %><br><br></p>
  
   <h4>Developers Assign to this projects are....</h4>
   <% @assign_developers=@project.developers%>
   <table class="table table-hover">
      <thead>
         <tr>
            <th scope="col">#</th>
            <th scope="col">Name</th>
            <th scope="col">Action</th>

         </tr>
      </thead>
      <tbody>
         <tr>
         <%count=0%>
         <% @assign_developers.each do |i| %>
            <tr>
            <th scope="row"><%= count+=1%></th>
            <td><%= i.name %></td>
            <td><%= link_to 'Remove Developer', remove_dev_project_path(@project,i),class:'btn btn-outline-secondary'%></td>
            </tr>
         <% end %>
         </tr>
      </tbody>
   </table>

   <%# <p><br><br>Remove Developer from this project...</p> %>
   <%# <%= form_with url: assign_project_project_path(@project), method: :post, model: @user do |f| %>
      <%# <%= f.select :did, @dev_assign.map {|i| [i.name, i.id]}, class:"btn btn-default btn-primary"%> 
      <%# <%= f.submit "Remove Developer", class:'btn btn-outline-secondary'%>   
   <%# <% end %> 

   <p><br><br>Assign Developer to this project...</p>
   <%= form_with url: assign_project_project_path(@project), method: :post, model: @user do |f| %>
      <%= f.select :uid, @unassign_developers.map {|i| [i.name, i.id]}, class:"btn btn-default btn-primary"%>
      <%= f.submit "Assign Developer", class:'btn btn-outline-secondary'%>  
   <% end %>
 
<%elsif(current_user.type=="Qa") %>
   <div class="row">
      <div class="col-6">
      </div>
      <div class="col-6">
        <%= link_to 'Create Bug', new_project_bug_path(@project),class:'btn btn-dark',style:"margin-left:79%;margin-top: -16%"%>
      </div>
      <br><br>
   </div>
   
   <h4>Name:</h4>
   <p><%= @project.name%></p>
   <h4>Description: </h4><p><%= @project.description%></p><br><br>
   <p><%= link_to 'Show Bugs', project_bugs_path(@project),class:'btn btn-outline-secondary' %>

<%else%>
   
   <h4>Name:</h4>
   <p><%= @project.name%></p>
   <h4>Description: </h4><p><%= @project.description%></p><br><br>
   <p><%= link_to 'Show Bugs', project_bugs_path(@project),class:'btn btn-outline-secondary' %>

<%end%>
<div class="container">
    <%= link_to 'Back', projects_path(@project), class:'btn btn-outline-secondary'%>
</div>











   


     