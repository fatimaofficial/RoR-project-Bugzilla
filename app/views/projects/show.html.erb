<div class="container">
  <h2>Project</h2>
  <div class="row">
  <div class="card" style="width: 18rem;margin-right: 8%;">
    <div class="card-body">
      <h5 class="card-title"><%= @project.name%></h5>
      <h6 class="card-subtitle mb-2 text-muted">Project id:<%= @project.id%></h6>
      <p class="card-text"><%= @project.description%></p>
      <%if(current_user.type=="Developer")%>
         <%= link_to 'Back', project_bugs_path(@project) ,class:'btn btn-outline-secondary'%> 
      <%else%>
         <%= link_to 'Back', projects_path(@project) ,class:'btn btn-outline-secondary'%> 
      <%end%>
    </div>
  </div>
  </div>
</div>
