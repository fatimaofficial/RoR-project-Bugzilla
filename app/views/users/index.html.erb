<h2>Employees</h2>

<table class="table table-hover">
  <thead>
    <tr>
      <th scope="col">#</th>
      <th scope="col">Name</th>
      <th scope="col">Email</th>
      <th scope="col">Type</th>
    </tr>
  </thead>
  <tbody>
    <tr>
     <%count=0%>
     <% @users.each do |i| %>
      <tr>
        <th scope="row"><%= count+=1%></th>
        <td><%= i.name %></td>
        <td><%= i.email %></td>
        <td><%= i.type %></td> 
      </tr>
     <% end %>
    </tr>
  </tbody>
</table>
